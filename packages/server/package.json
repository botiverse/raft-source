{
  "name": "@botiverse/raft-server",
  "version": "1.13.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "generate:wiki-workspace-pack": "node scripts/generateWikiWorkspacePack.mjs",
    "check:wiki-workspace-pack-fresh": "pnpm generate:wiki-workspace-pack && git diff --exit-code src/generated/wikiAgentWorkspacePack.ts",
    "test": "vitest run",
    "test:redis-tls": "bash scripts/test-redis-tls.sh",
    "test:api": "vitest run api.test.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:feature-flag-rollout-real-pg": "FEATURE_FLAG_ROLLOUT_REAL_PG_REQUIRED=1 vitest run src/services/featureFlagRolloutWriterService.realPg.test.ts",
    "test:activity-sync-real-pg": "ACTIVITY_SYNC_REAL_PG_REQUIRED=1 vitest run src/services/activitySyncService.realPg.test.ts",
    "test:attachment-lifecycle-real-pg": "ATTACHMENT_LIFECYCLE_REAL_PG_REQUIRED=1 vitest run src/services/attachmentLifecycleService.realPg.test.ts",
    "test:risingwave-inbox-prepare-real-rw": "RISINGWAVE_INBOX_PREPARE_REAL_RW_REQUIRED=1 vitest run src/services/channelService.risingwavePrepare.realRw.test.ts",
    "test:channel-lifecycle-real-pg": "CHANNEL_LIFECYCLE_REAL_PG_REQUIRED=1 vitest run src/services/channelLifecycle.realPg.test.ts",
    "test:agent-migration-legacy-repair-real-pg": "AGENT_MIGRATION_LEGACY_REPAIR_REAL_PG_REQUIRED=1 vitest run src/services/agentMigrationLegacyRepairService.realPg.test.ts",
    "test:task-assignment-real-pg": "TASK_ASSIGNMENT_REAL_PG_REQUIRED=1 vitest run src/services/taskService.assignment.realPg.test.ts",
    "test:external-inbound-real-pg": "EXTERNAL_INBOUND_REAL_PG_REQUIRED=1 vitest run src/services/externalInboundWorkerService.realPg.test.ts",
    "test:e2e:server": "tsx src/test/startPlaywrightServer.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "tsx scripts/migration-preflight.ts && tsx scripts/migrate-deploy.ts && tsx scripts/verify-feature-flag-admin-privileges.ts",
    "db:push": "drizzle-kit push",
    "db:create-message-random-id-index": "tsx scripts/create-message-random-id-index.ts",
    "db:verify-message-random-id-index": "tsx scripts/verify-message-random-id-index.ts",
    "db:create-inbox-serving-rows-receiver-server-index": "tsx scripts/create-inbox-serving-rows-receiver-server-index.ts",
    "db:verify-inbox-serving-rows-receiver-server-index": "tsx scripts/verify-inbox-serving-rows-receiver-server-index.ts",
    "db:create-messages-sender-index": "tsx scripts/create-messages-sender-index.ts",
    "db:verify-messages-sender-index": "tsx scripts/verify-messages-sender-index.ts",
    "search:backfill": "tsx scripts/backfill-search.ts",
    "mentions:backfill": "tsx scripts/backfill-message-mentions.ts",
    "newsletter:backfill": "tsx scripts/backfill-newsletter-audience.ts",
    "attachments:backfill-objects": "tsx scripts/backfill-attachment-objects.ts",
    "attachments:inventory-artifacts": "tsx scripts/inventory-attachment-artifacts.ts",
    "translations:backfill": "tsx scripts/backfill-message-translations.ts",
    "machines:backfill-computer-versions": "tsx scripts/backfill-machine-computer-versions.ts",
    "risingwave:bootstrap-local": "tsx scripts/bootstrap-risingwave-local.ts",
    "risingwave:verify-inbox-parity": "tsx scripts/verify-risingwave-inbox-parity.ts",
    "reconcile:slack-bridge-oauth-identity": "tsx scripts/reconcile-slack-bridge-oauth-identity.ts",
    "migration:repair-john-completion": "tsx scripts/ops/incidents/task-39/repair-john-agent-migration-completion.ts",
    "dm:repair-duplicates": "tsx scripts/repair-dm-duplicate-channels.ts",
    "threads:cleanup-empty": "tsx scripts/cleanup-empty-thread-channels.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1107.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/client-ssm": "^3.1020.0",
    "@aws-sdk/client-secrets-manager": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@electric-sql/pglite": "^0.4.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@botiverse/raft-shared": "workspace:*",
    "@botiverse/raft-sync-core": "workspace:*",
    "@smithy/node-http-handler": "^4.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "heic-decode": "2.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jieba-wasm": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.7",
    "marked-plaintify": "^1.1.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "resend": "^6.10.0",
    "scopedb": "0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "undici": "^7.24.7",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/heic-decode": "2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "ajv": "8.17.1",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
