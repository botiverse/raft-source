# @botiverse/raft-server — Express + PostgreSQL backend
# Copy to .env for local development. Railway/production: set in platform dashboard.

# ── Required ─────────────────────────────────────────────────

# PostgreSQL connection string
# Local:      postgresql://postgres:postgres@localhost:5432/slock
# Neon (prod): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/slock?sslmode=require
DATABASE_URL=postgresql://postgres:slock123@localhost:5432/slock

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-256-bit-random-value

# ── Optional ─────────────────────────────────────────────────

# HTTP port
PORT=3001

# Set to "production" on Railway — enables trust proxy for rate limiter
# NODE_ENV=production

# Browser app origins allowed to call/embed API-owned surfaces.
# Defaults to APP_URL when set, otherwise http://localhost:5173.
# Comma-separated for multiple: https://app.slock.ai,https://staging.slock.ai
CORS_ORIGIN=http://localhost:5173

# Origins of a page that frames the Raft app itself (Deck: https://deck.raft.build
# for Raft's own; https://your-deck-host.example for yours). Added to the
# attachment previews' frame-ancestors only (frame-ancestors names every
# ancestor, so a preview the app frames is blank inside Deck without it): never a
# CORS origin, a redirect target or a message origin. Comma or space separated
# exact https origins; a bad entry refuses to start. Unset: none (local/dev).
# FRAMED_BY_ORIGINS=

# Public URL that daemons use to connect back to this server
SERVER_URL=http://localhost:3001
# Public base for share artifact pages. Include the path if the public host
# routes share pages below /share; defaults to ${SERVER_URL}/share.
# SHARE_BASE_URL=https://share.slock.ai/share

# ── antiproton hosted agent runtime (optional) ───────────────
# The base URL is fixed by DEPLOYMENT_ENV (staging → https://preview.antiproton.ai,
# production → https://antiproton.ai; nothing elsewhere). Set the token to offer
# "Run on antiproton" for external agents; servers also need the
# `antiproton_hosted_runtime` feature flag. antiproton mints the token for this
# deployment's SERVER_URL origin. Pending agent credentials are encrypted with
# SLOCK_PROVIDER_CREDENTIAL_KEY.
# ANTIPROTON_PROVISIONING_TOKEN=pt-...
# Held-call approvals also need the public keys antiproton signs its approval
# hints with (not secret): key id → standard base64 of the raw 32-byte Ed25519
# public key, two ids at once while antiproton rotates. Unset or invalid: no
# approvals (docs/contracts/hosted-agent-approvals.md#configuration).
# ANTIPROTON_APPROVAL_HINT_PUBLIC_KEYS={"<key id>":"<base64 public key>"}

# Deployment environment — set to "staging" to show the staging banner
# DEPLOYMENT_ENV=staging

# ── Official Apps (optional) ─────────────────────────────────
# Official = the App's Server is an official publisher AND it has an approved
# official_app_registry entry from that Server (Feature Flag Admin).
# Primary root: the Raft Server itself (/raft in production). Also the only
# Server whose auto_install Apps are installed on new Servers.
# RAFT_OFFICIAL_PUBLISHER_SERVER_ID=
# More official publisher Servers, comma-separated Server ids; their Apps are
# never auto-installed. All or nothing: an empty or non-UUID item makes the
# whole value ignored (logged once).
# RAFT_OFFICIAL_PUBLISHER_SERVER_IDS=

# ── Redis (optional) ─────────────────────────────────────────
# Enables multi-replica support: Socket.io adapter, cross-replica routing,
# distributed locks, and externalized state. Not needed for single-replica.
# REDIS_URL=redis://localhost:6379

# ── Email (optional) ────────────────────────────────────────
# If RESEND_API_KEY is not set, emails are printed to console.

# RESEND_API_KEY=re_xxxxxxxxxx
# FROM_EMAIL=Slock <noreply@slock.ai>
# Newsletter contact/segment sync. Signup is fail-open if Resend is down.
# RESEND_NEWSLETTER_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_NEWSLETTER_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Canonical user-facing web app origin for emails, device login, social-auth
# completion redirects, web push URLs, reminders, and server-side permalink
# parsing. This is independent from SERVER_URL/VITE_API_URL, CDN_BASE_URL, and
# SHARE_BASE_URL.
# APP_URL=http://localhost:5173
# Optional comma-separated extra app hostnames/origins that permalink parsing
# should accept during domain migrations (server-side, and clients through
# GET /api/public/client-config's appHosts).
# APP_PERMALINK_HOSTS=

# Passkeys (two-step verification). Both unset:
# passkeys are unavailable (their routes answer 503 passkeys_unavailable).
# Set explicitly, never derived: every registered passkey is bound to the RP ID,
# so it can never change afterwards. WEBAUTHN_RP_ID must be the APP_URL hostname
# or a registrable suffix of it; each WEBAUTHN_ORIGINS entry is an https origin
# (http only for localhost outside production) on the RP ID. The server refuses
# to start when they are set but inconsistent. Desktop's app://raft is never one.
# Production: WEBAUTHN_RP_ID=raft.build, WEBAUTHN_ORIGINS=https://app.raft.build
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:5173

# ── Social Login (optional) ─────────────────────────────────
# Cloud edition only: if set, Google, GitHub and Apple sign-in are enabled in
# the frontend and auth routes (each provider is offered once its own env vars
# below are set). The source-available edition has no social login whatever
# these say (src/edition.ts).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional explicit override; defaults to ${SERVER_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional explicit override; defaults to ${SERVER_URL}/api/auth/github/callback
# GITHUB_REDIRECT_URI=
# Web Services ID / client_id. Associate it with the same primary App ID as
# the iOS client so Apple returns the same team-scoped `sub` across platforms.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=                           # supports \n-escaped private keys
# APPLE_CLIENT_SECRET=                         # optional precomputed client secret JWT
# Optional explicit HTTPS override; Apple web return URLs cannot use localhost
# or an IP address. Defaults to ${SERVER_URL}/api/auth/apple/callback.
# APPLE_REDIRECT_URI=
# Native iOS App ID / bundle identifier. This is intentionally separate from
# the web Services ID above. The native code exchange omits redirect_uri and
# verifies both the app-returned and Apple-exchanged identity tokens against
# this audience. A dedicated precomputed secret may be supplied; otherwise the
# shared Team/Key/private-key material above signs a short-lived client secret.
# APPLE_IOS_CLIENT_ID=build.raft.app
# APPLE_IOS_CLIENT_SECRET=
# Optional independent signing key for the server-issued native request
# capability; falls back to SOCIAL_AUTH_STATE_SECRET/JWT_SECRET.
# NATIVE_APPLE_AUTH_STATE_SECRET=
# Optional separate secret for short-lived OAuth state signing; falls back to JWT_SECRET
# SOCIAL_AUTH_STATE_SECRET=

# ── Web Push (optional) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@raft.build

# ── Product Feedback via Hands (optional) ──────────────────
# Server-only client key for the dedicated raft-web app. Never expose this in
# Vite/Web environment variables or browser bundles.
# HANDS_FEEDBACK_CLIENT_KEY=qk_xxxxxxxxxx
# App token with only the Hands `feedback:write` permission, used by the Raft
# Server trusted proxy. This token cannot read tickets, sign in, or publish.
# HANDS_FEEDBACK_APP_TOKEN=
# Independent high-entropy HMAC secret. It turns Raft user ids into stable,
# irreversible reporter keys for Hands rate limiting.
# HANDS_FEEDBACK_REPORTER_ID_SECRET=
# HANDS_FEEDBACK_APP_SLUG=raft-web
# HANDS_FEEDBACK_BASE_URL=https://hands.build
# Conversation proxy stays independently fail-closed until every setting below
# is present. The credential is role-free with exact Hands permissions
# feedback:write/read/comment; revision is a non-secret stable credential id.
# HANDS_FEEDBACK_APP_ID=850a1eca-2664-4e44-9020-51fbdf7a8a70
# HANDS_FEEDBACK_CONVERSATION_APP_TOKEN=
# HANDS_FEEDBACK_CONVERSATION_CREDENTIAL_REVISION=
# Independent HMAC key for Raft-authenticated pagination envelopes. Do not reuse
# the reporter identity secret or a future webhook secret.
# HANDS_FEEDBACK_CURSOR_SECRET=
# Unread push (services/productFeedbackUnreadReconcile.ts): one run a minute
# across replicas reads the Hands reporter change feed of the web app above and
# pushes a reporter's unread total over the socket (product_feedback:unread)
# when a ticket of theirs got a new public reply. It uses the conversation
# credential above (no other token) and reads ticket details with
# mark_read=false only. Off unless set to true (one startup log line), and
# then only with the conversation and route-subject settings complete.
# With it on, each mobile source that has an app below gets the same job on its
# own app (product_feedback:app_unread, with its source); a source's entry
# never turns the job on or off.
# HANDS_FEEDBACK_UNREAD_RECONCILE_ENABLED=true
# Per-client Hands apps for the mobile sources (web always uses the single app
# above): the server reads one SecureString JSON from SSM at runtime, named by
# HANDS_FEEDBACK_APPS_SSM_PARAMETER (for example /your-app/<env>/HANDS_FEEDBACK_APPS).
# Shape:
#   {"shared":{"reporter_id_secret","route_subject_root","cursor_secret"},
#    "android|ios|ohos":{"app_slug","app_id","reporter_integration_id",
#                        "credential_revision","client_key","token"}}
# A mobile source without its entry answers 503. A "web" entry is ignored (moving
# web needs a migration: web tickets would move to a new reporter id). Use the
# AWS-managed aws/ssm key, or grant kms:Decrypt for a custom key.
# HANDS_FEEDBACK_APPS_SSM_PARAMETER=
# Product feedback triage notice (#35): after Hands files a ticket, one
# `system.feedback` app notice goes to this agent's inbox (no user text: client,
# server name, ticket id, Lens link, time). Unset or not an agent id: none.
# PRODUCT_FEEDBACK_TRIAGE_AGENT_ID=
# Lens, linked from the notice: /f/<reportId> for agent reports, else /feedback
# (default https://lens.botiverse.workers.dev).
# LENS_BASE_URL=https://lens.botiverse.workers.dev

# Task #374: close the older of two live connections that share a machine key
# and refuse new ones while the winner is alive. Off by default (observe only).
# SLOCK_MACHINE_DUPLICATE_CONNECTION_ENFORCEMENT=1

# ── Mobile APNs Push (optional) ─────────────────────────────
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY= # supports \n-escaped private keys
# APNs topics (bundle ids) registrations may use and the server pushes to,
# comma-separated. Default: build.raft.app. Any other topic is refused at
# POST /push/registrations and revoked on its next send.
# APNS_ALLOWED_TOPICS=build.raft.app
# ── Mobile FCM Push (optional, Android) ─────────────────────
# Google credential JSON: a Workload Identity Federation config (no long-lived
# key; on ECS the AWS task role is used). A service account key works for local
# development only; NODE_ENV=production refuses it.
# FCM_CREDENTIALS_JSON=
# FCM_PROJECT_ID= # Firebase project; optional when the key JSON has project_id
# ── Stripe Billing (optional) ──────────────────────────────
# Billing stays disabled unless this flag is explicitly true and all Stripe
# secret + canonical Pro Seat price IDs are set.
# STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx
# STRIPE_PRO_SEAT_MONTHLY_PRICE_ID=price_xxxxxxxxxx
# STRIPE_PRO_SEAT_ANNUAL_PRICE_ID=price_xxxxxxxxxx
# Stripe Checkout shows its promotion-code input. Manage individual promotion
# code availability through Stripe Dashboard restrictions and status.

# ── File Storage (optional) ─────────────────────────────────
# S3-compatible storage for image attachments.
# If not set, file uploads are disabled.
# Works with AWS S3, Cloudflare R2, MinIO, etc.

# S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=xxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_ATTACHMENTS_BUCKET=your-attachments-bucket  # Private bucket for originals (served via presigned URLs)
# S3_CDN_BUCKET=your-content-bucket            # Public bucket for thumbnails and previews (served via CDN)
# CDN_BASE_URL=https://cdn.raft.build          # Public base URL for the CDN bucket (legacy and content/v2 keys)
# S3_PUBLIC_URL=https://pub.r2.dev/bucket     # Optional: public URL for S3 objects (bypasses presigned URLs)
# Direct attachment upload is advertised only when the private storage backend
# supports conditional presigned PUT + HEAD. The threshold is server-owned and
# returned to Web/CLI; clients must not copy it. The bucket also needs exact-
# origin CORS for PUT with Content-Type and If-None-Match.
# Direct-upload objects stay in a dedicated private bucket. This configuration
# is intentionally all-or-nothing and never inherits the legacy S3 credentials
# above. Downloads and lifecycle cleanup route by the persisted
# attachments/v1/ storage-key namespace.
# S3_DIRECT_UPLOAD_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_DIRECT_UPLOAD_REGION=auto
# S3_DIRECT_UPLOAD_ACCESS_KEY_ID=xxxxxxxxxx
# S3_DIRECT_UPLOAD_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_DIRECT_UPLOAD_BUCKET=your-attachments-bucket
# S3_DIRECT_UPLOAD_FORCE_PATH_STYLE=true
# The CDN bucket's own connection (S3_CDN_BUCKET above). With all three of
# endpoint and key pair set, the CDN bucket uses it instead of the main S3_*
# credentials (a partial set is ignored with a warning), and fresh attachment
# thumbnails and SVG raster previews are written under content/v2/ keys once
# CDN_BASE_URL is set too. content/v2 storage never inherits the main
# credentials: without these it is off and fresh writes keep legacy keys.
# Existing keys always route by prefix; both kinds are served from CDN_BASE_URL.
# S3_CDN_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_CDN_REGION=auto
# S3_CDN_ACCESS_KEY_ID=xxxxxxxxxx
# S3_CDN_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_CDN_FORCE_PATH_STYLE=true
# DEPRECATED, fallback only: the public-content names below pointed at the
# same bucket as the CDN names. Each is read only when its CDN name
# (S3_CDN_ENDPOINT, S3_CDN_REGION, S3_CDN_ACCESS_KEY_ID,
# S3_CDN_SECRET_ACCESS_KEY, S3_CDN_BUCKET, S3_CDN_FORCE_PATH_STYLE,
# CDN_BASE_URL) is unset or blank; when both are set, the CDN name wins. The
# endpoint and key pair fill in as one unit, never mixed with the CDN's. The
# server logs a warning naming each one it falls back to (names only). Do not
# set them in new deployments; they will be removed.
# S3_PUBLIC_CONTENT_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_PUBLIC_CONTENT_REGION=auto
# S3_PUBLIC_CONTENT_ACCESS_KEY_ID=xxxxxxxxxx
# S3_PUBLIC_CONTENT_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_PUBLIC_CONTENT_BUCKET=your-content-bucket
# S3_PUBLIC_CONTENT_FORCE_PATH_STYLE=true
# PUBLIC_CONTENT_BASE_URL=https://content.raft.build
# The platform's app-content bucket: one private bucket where every first-party
# app keeps its objects, each under its own apps/<id>/ prefix (Workspace
# Artifacts' file bytes under apps/artifacts/). Apps never get the bucket or
# these credentials. All or nothing; always path-style; never inherits the
# attachment, CDN or public-content settings. Unset: an app's object storage is
# unavailable (Artifacts' files answer 503 ARTIFACTS_STORAGE_UNAVAILABLE).
# APP_STORAGE_R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# APP_STORAGE_R2_REGION=auto
# APP_STORAGE_R2_ACCESS_KEY_ID=xxxxxxxxxx
# APP_STORAGE_R2_SECRET_ACCESS_KEY=xxxxxxxxxx
# APP_STORAGE_R2_BUCKET=your-app-objects-bucket
# Workspace Artifacts' content origin (S2, docs/development/workspace-artifacts-content-origin.md).
# Raft signs each frame's one-time ticket with its own token (one of the Worker's
# RAFT_TOKENS, which verify it; no call to the Worker); token and domain both or nothing,
# token at least 32 random bytes. ARTIFACTS_CONTENT_DOMAIN is the content domain
# (host[:port], the web build's VITE_ARTIFACTS_CONTENT_DOMAIN): a frame opens on that
# Artifact's own w-<uuid> label under it. Unset: html, markdown and pdf Artifacts answer
# 503 CONTENT_UNAVAILABLE on POST /api/artifacts/:id/frame, and the viewer has no frame.
# The server refuses to start if the content domain is one of Raft's app hosts (APP_URL's,
# APP_PERMALINK_HOSTS, app.raft.build, the earlier slock hosts) or a parent or subdomain of one.
# ARTIFACTS_CONTENT_WORKER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ARTIFACTS_CONTENT_DOMAIN=raftusercontent-preview.example
# Embeds of public Artifacts on any site (#proj-workspace:#260): the content Worker's embed
# host as an origin (its EMBED_DOMAIN, with EMBEDS on). Sent to clients as the client
# config's artifactsEmbedOrigin; the web offers Copy embed code only while it is set. It is
# the server's embed switch: unset, the Worker's embed question answers 404 for every
# Artifact, so live embeds blank within 30 s too. The Worker's EMBEDS is the hard kill
# switch beside it: turn both off together (EMBEDS off alone leaves the item offered, its
# embeds the Worker's "isn't available" page).
# ARTIFACTS_EMBED_ORIGIN=https://embed.raftusercontent-preview.example
# The tokens the Worker calls /internal/artifacts-content/* with (its RAFT_API_TOKEN),
# comma-separated so a rotation can list old and new; each at least 32 bytes. Unset:
# those routes answer 404.
# ARTIFACTS_CONTENT_RAFT_TOKENS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The publish check Worker's token (task #130): what it calls
# /internal/artifacts-check/* (lease, result) with. At least 32 bytes, its own (never
# one of the content Worker's tokens above). Unset or unusable: those routes answer 503
# and no check is leased.
# ARTIFACTS_CHECK_WORKER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Importing one Artifact of the standalone app (raft-artifacts.com) on demand
# (POST /api/artifacts/import, raft artifact import). Raft calls only this fixed
# address, never a link it is given; the token is the standalone app's import
# token, its own secret (not any of the above), at least 32 characters (the app
# ignores shorter ones). Both or nothing; unset: 503 IMPORT_UNAVAILABLE.
# ARTIFACTS_LEGACY_IMPORT_URL=https://raft-artifacts.com
# ARTIFACTS_LEGACY_IMPORT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Hosts besides raft-artifacts.com (and www., artifact-share.botiverse.dev) whose
# /p/<server>/<name> links count as the standalone app's (a staging copy), comma-separated.
# ARTIFACTS_LEGACY_LINK_HOSTS=
# ATTACHMENT_DIRECT_UPLOAD_ENABLED=false             # Exact true only; rollout remains default-off
# ATTACHMENT_DIRECT_UPLOAD_THRESHOLD_BYTES=10485760  # 10 MiB (default); may lower, but cannot raise, the 90 MiB legacy Web safety cap
# ATTACHMENT_DIRECT_UPLOAD_SESSION_TTL_MS=900000     # 15 minutes

# ── Local uploads (dev fallback) ─────────────────────────────
# If S3 is not configured, files are stored locally by default.
# UPLOADS_LOCAL=false                          # Set to "false" to disable local uploads entirely
# UPLOADS_DIR=/path/to/uploads                 # Custom upload directory (default: ./uploads)

# Generic scope attestation signing for external workers.
# SCOPE_ATTESTATION_SECRET=

# Base64-encoded 32-byte AES key for write-only Managed MCP credential headers.
# Generate with: openssl rand -base64 32
# SLOCK_MCP_CREDENTIAL_KEY=

# ── Message Translation (optional) ──────────────────────────
# Azure Translator is used by default when endpoint/key are configured.
# Set TRANSLATION_PROVIDER=volcengine for Volcengine TranslateText, or
# TRANSLATION_PROVIDER=google for Google Cloud Translation Advanced v3, or
# TRANSLATION_PROVIDER=openai-compatible for server-side LLM translation. In AWS,
# set TRANSLATION_SSM_ENVIRONMENT=staging or production. The server reads the
# exact /slock/{environment}/translation/{provider,endpoint,model,api-key}
# parameters at startup; provider/endpoint/model are String and api-key is a
# SecureString. Do not inject the token or these values into client settings.
# Local tests may continue to use the explicit TRANSLATION_* variables below.
# TRANSLATION_SSM_ENVIRONMENT=
# TRANSLATION_PROVIDER=google for Google Cloud Translation Advanced v3.
# TRANSLATION_PROVIDER=
# TRANSLATION_AZURE_ENDPOINT=
# TRANSLATION_AZURE_API_KEY=
# TRANSLATION_AZURE_REGION=
# TRANSLATION_VOLCENGINE_ACCESS_KEY_ID=
# TRANSLATION_VOLCENGINE_SECRET_ACCESS_KEY=
# TRANSLATION_VOLCENGINE_REGION=cn-north-1
# TRANSLATION_VOLCENGINE_ENDPOINT=https://translate.volcengineapi.com
# TRANSLATION_GOOGLE_PROJECT_ID=
# TRANSLATION_GOOGLE_LOCATION=global
# TRANSLATION_GOOGLE_SERVICE_ACCOUNT_JSON= # raw service account JSON or base64-encoded JSON
# TRANSLATION_GOOGLE_CLIENT_EMAIL=
# TRANSLATION_GOOGLE_PRIVATE_KEY= # supports \n-escaped private keys
# TRANSLATION_GOOGLE_QUOTA_PROJECT_ID= # optional billing/quota project for user OAuth access tokens
# TRANSLATION_GOOGLE_ACCESS_TOKEN= # optional short-lived token for local smoke tests
# TRANSLATION_GOOGLE_ENDPOINT=https://translate.googleapis.com

# Authenticated relay for Cloudflare Workers to send OTLP HTTP to internal Telescope.
# OTLP_RELAY_AUTHORIZATION="Bearer shared-secret"
# OTLP_RELAY_TARGET_URL=http://telescope.raft-staging.local:4318/v1/traces
# OTLP_RELAY_MAX_BYTES=10485760

# Image decodes (sharp: comment images, check screenshots, thumbnails, avatars,
# App logos) this process runs at once; the rest wait their turn
# (src/lib/imageDecodeLimit.ts). An integer, clamped to 1..16; default 2.
# IMAGE_DECODE_CONCURRENCY=2

# Account deletion: days between a deletion request and the account's deletion
# (services/accountDeletion/requests.ts; default 7). A positive integer.
# ACCOUNT_DELETION_GRACE_DAYS=7

# Trace-upload receiver this server tells its machines (Raft Computer runners /
# daemons) to upload trace bundles to, via `machine:context.traceUploadUrl`.
# Unset => not sent; daemons use the default for their server (staging receiver for the AWS staging server, production for Raft's production server, none for any other server). Daemons accept only
# https://slock-trace-upload.botiverse.dev, or a loopback URL only from a loopback server; the machine
# owner's SLOCK_DAEMON_TRACE_UPLOAD_URL always wins (packages/daemon/src/traceUploadUrl.ts).
# SLOCK_MACHINE_TRACE_UPLOAD_URL=http://localhost:18787
