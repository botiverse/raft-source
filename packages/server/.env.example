# @botiverse/raft-server — Express + PostgreSQL backend
# Copy to .env for local development. Railway/production: set in platform dashboard.

# ── Required ─────────────────────────────────────────────────

# PostgreSQL connection string
# Local:      postgresql://postgres:postgres@localhost:5432/slock
# Neon (prod): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/slock?sslmode=require
DATABASE_URL=postgresql://postgres:slock123@localhost:5432/slock

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-256-bit-random-value

# ── Optional ─────────────────────────────────────────────────

# HTTP port
PORT=3001

# Set to "production" on Railway — enables trust proxy for rate limiter
# NODE_ENV=production

# Browser app origins allowed to call/embed API-owned surfaces.
# Defaults to APP_URL when set, otherwise http://localhost:5173.
# Comma-separated for multiple: https://app.slock.ai,https://staging.slock.ai
CORS_ORIGIN=http://localhost:5173

# Public URL that daemons use to connect back to this server
SERVER_URL=http://localhost:3001
# Public base for share artifact pages. Include the path if the public host
# routes share pages below /share; defaults to ${SERVER_URL}/share.
# SHARE_BASE_URL=https://share.slock.ai/share

# Deployment environment — set to "staging" to show the staging banner
# DEPLOYMENT_ENV=staging

# ── Redis (optional) ─────────────────────────────────────────
# Enables multi-replica support: Socket.io adapter, cross-replica routing,
# distributed locks, and externalized state. Not needed for single-replica.
# REDIS_URL=redis://localhost:6379

# ── Email (optional) ────────────────────────────────────────
# If RESEND_API_KEY is not set, emails are printed to console.

# RESEND_API_KEY=re_xxxxxxxxxx
# FROM_EMAIL=Slock <noreply@slock.ai>
# Newsletter contact/segment sync. Signup is fail-open if Resend is down.
# RESEND_NEWSLETTER_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_NEWSLETTER_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Canonical user-facing web app origin for emails, device login, social-auth
# completion redirects, web push URLs, reminders, and server-side permalink
# parsing. This is independent from SERVER_URL/VITE_API_URL, CDN_BASE_URL, and
# SHARE_BASE_URL.
# APP_URL=http://localhost:5173
# Optional comma-separated extra app hostnames/origins that server-side
# permalink parsing should accept during domain migrations.
# APP_PERMALINK_HOSTS=

# ── Social Login (optional) ─────────────────────────────────
# If set, Google and GitHub sign-in are enabled in the frontend and auth routes.
# Apple also needs these env vars, but remains hidden from web clients until
# the apple_web_login_v0 feature flag allows the web platform.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional explicit override; defaults to ${SERVER_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional explicit override; defaults to ${SERVER_URL}/api/auth/github/callback
# GITHUB_REDIRECT_URI=
# Web Services ID / client_id. Associate it with the same primary App ID as
# the iOS client so Apple returns the same team-scoped `sub` across platforms.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=                           # supports \n-escaped private keys
# APPLE_CLIENT_SECRET=                         # optional precomputed client secret JWT
# Optional explicit HTTPS override; Apple web return URLs cannot use localhost
# or an IP address. Defaults to ${SERVER_URL}/api/auth/apple/callback.
# APPLE_REDIRECT_URI=
# Native iOS App ID / bundle identifier. This is intentionally separate from
# the web Services ID above. The native code exchange omits redirect_uri and
# verifies both the app-returned and Apple-exchanged identity tokens against
# this audience. A dedicated precomputed secret may be supplied; otherwise the
# shared Team/Key/private-key material above signs a short-lived client secret.
# APPLE_IOS_CLIENT_ID=build.raft.app
# APPLE_IOS_CLIENT_SECRET=
# Optional independent signing key for the server-issued native request
# capability; falls back to SOCIAL_AUTH_STATE_SECRET/JWT_SECRET.
# NATIVE_APPLE_AUTH_STATE_SECRET=
# Optional separate secret for short-lived OAuth state signing; falls back to JWT_SECRET
# SOCIAL_AUTH_STATE_SECRET=

# ── Web Push (optional) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@raft.build

# ── Product Feedback via Hands (optional) ──────────────────
# Server-only client key for the dedicated raft-web app. Never expose this in
# Vite/Web environment variables or browser bundles.
# HANDS_FEEDBACK_CLIENT_KEY=qk_xxxxxxxxxx
# App token with only the Hands `feedback:write` permission, used by the Raft
# Server trusted proxy. This token cannot read tickets, sign in, or publish.
# HANDS_FEEDBACK_APP_TOKEN=
# Independent high-entropy HMAC secret. It turns Raft user ids into stable,
# irreversible reporter keys for Hands rate limiting.
# HANDS_FEEDBACK_REPORTER_ID_SECRET=
# HANDS_FEEDBACK_APP_SLUG=raft-web
# HANDS_FEEDBACK_BASE_URL=https://hands.build
# Conversation proxy stays independently fail-closed until every setting below
# is present. The credential is role-free with exact Hands permissions
# feedback:write/read/comment; revision is a non-secret stable credential id.
# HANDS_FEEDBACK_APP_ID=850a1eca-2664-4e44-9020-51fbdf7a8a70
# HANDS_FEEDBACK_CONVERSATION_APP_TOKEN=
# HANDS_FEEDBACK_CONVERSATION_CREDENTIAL_REVISION=
# Independent HMAC key for Raft-authenticated pagination envelopes. Do not reuse
# the reporter identity secret or a future webhook secret.
# HANDS_FEEDBACK_CURSOR_SECRET=

# ── Mobile APNs Push (optional) ─────────────────────────────
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY= # supports \n-escaped private keys
# ── Stripe Billing (optional) ──────────────────────────────
# Billing stays disabled unless this flag is explicitly true and all Stripe
# secret + canonical Pro Seat price IDs are set.
# STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx
# STRIPE_PRO_SEAT_MONTHLY_PRICE_ID=price_xxxxxxxxxx
# STRIPE_PRO_SEAT_ANNUAL_PRICE_ID=price_xxxxxxxxxx
# Stripe Checkout shows its promotion-code input. Manage individual promotion
# code availability through Stripe Dashboard restrictions and status.

# ── File Storage (optional) ─────────────────────────────────
# S3-compatible storage for image attachments.
# If not set, file uploads are disabled.
# Works with AWS S3, Cloudflare R2, MinIO, etc.

# S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=xxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_ATTACHMENTS_BUCKET=slock-attachments     # Private bucket for originals (served via presigned URLs)
# S3_CDN_BUCKET=slock-cdn                     # Public bucket for thumbnails (served via CDN)
# CDN_BASE_URL=https://cdn.slock.ai           # Public base URL for the CDN bucket
# S3_PUBLIC_URL=https://pub.r2.dev/bucket     # Optional: public URL for S3 objects (bypasses presigned URLs)
# Direct attachment upload is advertised only when the private storage backend
# supports conditional presigned PUT + HEAD. The threshold is server-owned and
# returned to Web/CLI; clients must not copy it. The bucket also needs exact-
# origin CORS for PUT with Content-Type and If-None-Match.
# Direct-upload objects stay in a dedicated private bucket. This configuration
# is intentionally all-or-nothing and never inherits the legacy S3 credentials
# above. Downloads and lifecycle cleanup route by the persisted
# attachments/v1/ storage-key namespace.
# S3_DIRECT_UPLOAD_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# S3_DIRECT_UPLOAD_REGION=auto
# S3_DIRECT_UPLOAD_ACCESS_KEY_ID=xxxxxxxxxx
# S3_DIRECT_UPLOAD_SECRET_ACCESS_KEY=xxxxxxxxxx
# S3_DIRECT_UPLOAD_BUCKET=slock-direct-attachments
# S3_DIRECT_UPLOAD_FORCE_PATH_STYLE=true
# ATTACHMENT_DIRECT_UPLOAD_ENABLED=false             # Exact true only; rollout remains default-off
# ATTACHMENT_DIRECT_UPLOAD_THRESHOLD_BYTES=10485760  # 10 MiB (default); may lower, but cannot raise, the 90 MiB legacy Web safety cap
# ATTACHMENT_DIRECT_UPLOAD_SESSION_TTL_MS=900000     # 15 minutes

# ── Local uploads (dev fallback) ─────────────────────────────
# If S3 is not configured, files are stored locally by default.
# UPLOADS_LOCAL=false                          # Set to "false" to disable local uploads entirely
# UPLOADS_DIR=/path/to/uploads                 # Custom upload directory (default: ./uploads)

# Generic scope attestation signing for external workers.
# SCOPE_ATTESTATION_SECRET=

# Base64-encoded 32-byte AES key for write-only Managed MCP credential headers.
# Generate with: openssl rand -base64 32
# SLOCK_MCP_CREDENTIAL_KEY=

# ── Message Translation (optional) ──────────────────────────
# Azure Translator is used by default when endpoint/key are configured.
# Set TRANSLATION_PROVIDER=volcengine for Volcengine TranslateText, or
# TRANSLATION_PROVIDER=google for Google Cloud Translation Advanced v3, or
# TRANSLATION_PROVIDER=openai-compatible for server-side LLM translation. In AWS,
# set TRANSLATION_SSM_ENVIRONMENT=staging or production. The server reads the
# exact /slock/{environment}/translation/{provider,endpoint,model,api-key}
# parameters at startup; provider/endpoint/model are String and api-key is a
# SecureString. Do not inject the token or these values into client settings.
# Local tests may continue to use the explicit TRANSLATION_* variables below.
# TRANSLATION_SSM_ENVIRONMENT=
# TRANSLATION_PROVIDER=google for Google Cloud Translation Advanced v3.
# TRANSLATION_PROVIDER=
# TRANSLATION_AZURE_ENDPOINT=
# TRANSLATION_AZURE_API_KEY=
# TRANSLATION_AZURE_REGION=
# TRANSLATION_VOLCENGINE_ACCESS_KEY_ID=
# TRANSLATION_VOLCENGINE_SECRET_ACCESS_KEY=
# TRANSLATION_VOLCENGINE_REGION=cn-north-1
# TRANSLATION_VOLCENGINE_ENDPOINT=https://translate.volcengineapi.com
# TRANSLATION_GOOGLE_PROJECT_ID=
# TRANSLATION_GOOGLE_LOCATION=global
# TRANSLATION_GOOGLE_SERVICE_ACCOUNT_JSON= # raw service account JSON or base64-encoded JSON
# TRANSLATION_GOOGLE_CLIENT_EMAIL=
# TRANSLATION_GOOGLE_PRIVATE_KEY= # supports \n-escaped private keys
# TRANSLATION_GOOGLE_QUOTA_PROJECT_ID= # optional billing/quota project for user OAuth access tokens
# TRANSLATION_GOOGLE_ACCESS_TOKEN= # optional short-lived token for local smoke tests
# TRANSLATION_GOOGLE_ENDPOINT=https://translate.googleapis.com

# Authenticated relay for Cloudflare Workers to send OTLP HTTP to internal Telescope.
# OTLP_RELAY_AUTHORIZATION="Bearer shared-secret"
# OTLP_RELAY_TARGET_URL=http://telescope.raft-staging.local:4318/v1/traces
# OTLP_RELAY_MAX_BYTES=10485760
