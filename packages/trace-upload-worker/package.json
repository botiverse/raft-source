{
  "name": "@botiverse/raft-trace-upload-worker",
  "version": "0.1.0",
  "license": "LicenseRef-Raft-License",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../shared/src --watch-path=../shared/assets --watch-path=../shared/announcement-audience.ts --watch-path=../shared/announcement-presentation.ts --watch-path=../shared/feature-flag-taxonomy.ts --watch-path=../sync-core/src --watch-path=../sync-core/contracts --watch-path=../trace-client/src --import @oxc-node/core/register src/node.ts",
    "start": "node --import @oxc-node/core/register src/node.ts",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "reingest": "node --import @oxc-node/core/register src/reingest.ts"
  },
  "dependencies": {
    "@botiverse/raft-shared": "workspace:*",
    "@oxc-node/core": "^0.1.6",
    "scopedb": "0.4.0"
  },
  "devDependencies": {
    "@botiverse/raft-trace-client": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
