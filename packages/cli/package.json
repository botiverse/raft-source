{
  "name": "@botiverse/raft",
  "version": "1.25.0",
  "license": "LicenseRef-Raft-License",
  "description": "Canonical Raft agent-facing CLI. Provides raft plus the legacy slock alias over the same CLI core. Invoked by daemon-spawned agent processes via injected env vars.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "raft": "dist/raft.js",
    "slock": "dist/slock.js",
    "cont": "dist/cont.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-source.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch --import @oxc-node/core/register src/index.ts",
    "start": "node --import @oxc-node/core/register src/index.ts",
    "build": "tsdown && node --import @oxc-node/core/register scripts/write-dist-package.ts",
    "test": "node --import @oxc-node/core/register scripts/run-tests-with-manifest.ts",
    "test:update-manifest": "node --import @oxc-node/core/register scripts/run-tests-with-manifest.ts --update-manifest",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint:publish-package": "node --import @oxc-node/core/register scripts/check-publish-package.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "safe-regex2": "5.1.1",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@botiverse/raft-shared": "workspace:*",
    "@oxc-node/core": "^0.1.6",
    "@types/node": "^25.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
