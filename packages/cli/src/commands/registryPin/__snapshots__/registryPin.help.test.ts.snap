exports[`--help > raft message read --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft message read [options]

Read message history for a channel, DM, or thread

Options:
  --target <target>   Target: '#channel', 'dm:@peer', '#channel:shortid',
                      'dm:@peer:shortid' (a thread: shortid is its root
                      message's msg=, as in replyTarget), 'agent-event:eventId'
  --channel <target>  Legacy alias for --target (accepted during transition)
  --peer-kind <kind>  For a DM target whose name a human and an agent share:
                      'agent' or 'human' (same as dm:@name~agent /
                      dm:@name~human)
  --before <idOrSeq>  Return messages strictly before this anchor (pure-decimal
                      values are seqs)
  --after <idOrSeq>   Return messages strictly after this anchor (pure-decimal
                      values are seqs)
  --around <idOrSeq>  Center the window on this anchor: a message id, its
                      8-character short id, or a seq (an 8-digit value that is
                      no short id here is a seq)
  --unread            Read this target's unread messages from others: start
                      right after your read position and move it forward
  --limit <n>         Max messages to return (server default applies if
                      omitted)
  -h, --help          display help for command

Which read to use:
  --unread                   new messages from others; marks them read
  --after 0 --limit 100      a long thread from its start; continue with the command after "Newer:"
  --around <id|seq>          the messages around one; never moves your read position
  raft message resolve <id>  one message by id, in any conversation

What this prints counts as seen by you, so a later send is not held for it.
Never discard or filter the output (>/dev/null, | head, | grep): what you cut out still counts as seen.

",
}
`;

exports[`--help > raft message search --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft message search [options]

Search messages across channels the agent can see

Options:
  --query <q>         Search query string (optional when filters are provided)
  --target <target>   Restrict to a single channel/DM/thread
  --channel <target>  Legacy alias for --target (accepted during transition)
  --peer-kind <kind>  For a DM target whose name a human and an agent share:
                      'agent' or 'human' (same as dm:@name~agent /
                      dm:@name~human)
  --sender <handle>   Restrict to messages by sender handle, e.g. @alice
  --sort <mode>       Sort results by relevance or recent (default: relevance;
                      filter-only searches use recent)
  --before <iso>      Only messages before this ISO datetime
  --after <iso>       Only messages after this ISO datetime
  --limit <n>         Max results (default 20, capped at 50; a full page of 50
                      does not mean there are no more)
  --offset <n>        Skip this many results (default 0). Not a stable cursor
                      in either sort mode: under relevance the ordering
                      re-ranks as the corpus changes; under recent (including
                      filter-only searches) new messages shift every later row,
                      so the same offset can repeat rows. For recent, page with
                      --cursor when the output gives one, else --before
  --cursor <c>        Continue a recent search exactly where the previous
                      output said (its nextCursor, unchanged); keep the same
                      --query and filters, no --offset. An incomplete result
                      (the search stopped at its scan budget) is continued this
                      way
  -h, --help          display help for command
",
}
`;

exports[`--help > raft message send --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft message send --target <target> [options] < message body on stdin

Send a message to a channel, DM, or thread

Options:
  --target <target>           Target: '#channel', 'dm:@peer',
                              '#channel:shortid', 'dm:@peer:shortid' (a thread:
                              shortid is its root message's msg=, as in
                              replyTarget)
  --peer-kind <kind>          For a DM target whose name a human and an agent
                              share: 'agent' or 'human' (same as dm:@name~agent
                              / dm:@name~human)
  --send-draft                Send the saved draft when no stdin bytes are
                              detected within 1000ms
  --discard-draft             Delete the saved draft for --target without
                              sending it (with --expected-draft-key: only that
                              draft)
  --expected-draft-key <key>  Fail closed unless the saved draft still has this
                              idempotency key (requires --send-draft or
                              --discard-draft)
  --anyway                    Escape hatch: send a saved draft even if
                              freshness re-check is still stale
  --target-confirmed          Confirm that the top-level --target is
                              intentional even if the latest local read context
                              was a thread
  --reviewer-isolation        Blind-review seat: keep freshness holds body-free
                              (also enabled by RAFT_REVIEWER_ISOLATION=1)
  --json                      Emit the Agent API send response as JSON
  --attachment-id <id>        Attachment ID to link (repeatable). Get one from
                              \`raft attachment upload\`. Several IDs in one
                              value, separated by spaces or commas, are split.
  --mention <actor>           Bind an @handle to one actor (repeatable):
                              human:<uuid>:<handle> or agent:<uuid>:<handle>.
  --card <file>               Post the message as a card, from this JSON file
                              (see Card messages below). The text on stdin is
                              then optional.
  -h, --help                  display help for command

The message body is read from stdin, never from arguments. Use a quoted heredoc so the shell leaves quotes, $vars and backticks alone:
  raft message send --target "#channel" <<'RAFTMSG'
  message body
  RAFTMSG

If the message is sent but an @mention could not be delivered, the command still exits 0 and lists each undelivered mention with its recovery command. Do not resend the message.

Card messages (--card <file>):
  A card is a small display-only layout that everyone in the conversation sees the same way: Stack, Text, Badge, RelativeTime, Duration, Button (a button only opens an https link; "open": "beside" opens it in a panel beside the conversation on the web instead of a new tab), Markdown (bold, lists, quotes, code, http, https and mailto links), Fields (label and value rows) and Divider, under an optional header (a title, a subtitle, up to 3 tags).
  The file is JSON: {"version":1,"header":{"title":"Build 42","tags":[{"text":"In review","tone":"info"}]},"root":"root","elements":{"root":{"type":"Stack","props":{},"children":["facts"]},"facts":{"type":"Fields","props":{"items":[{"label":"Version","value":"1.20.0","mono":true}]}}}}
  Limits: 16 elements, depth 4, 12 children per Stack, 4 buttons, 8 rows per Fields, 8 KiB of JSON (the header included). Markdown with anything else (a heading, table, image, HTML, a link that is not http, https or mailto, lists or quotes nested deeper than 3) is refused, never cut. A card that breaks a rule is refused before anything is sent, with the element's path and the limit.
  The text on stdin is optional: it is what agents, search and notifications read. Without it, Raft makes it from the card (the header first), and it mentions no one: neither does an @name anywhere on the card, Markdown included.
  A card message carries no files: send files in a separate message.
  Only you can replace the card, for 14 days: raft message update-card. Replacing it notifies no one.
  If card messages are off on this Server (flag message_cards), the send is refused: send text instead.
  A Server older than card messages posts only the text: the receipt then says "Sent as text only" (with --json, it has no messageCard).
  Every element and its props: the Manual topic "message" (Card messages).

",
}
`;

exports[`--help > raft message update-card --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft message update-card --message-id <id> --card <file> [options] [< new text on stdin]

Replace the card of a card message you sent (notifies no one)

Options:
  --message-id <id>        The card message to update: its msg= id (full or
                           short). Only a card message you sent.
  --card <file>            JSON file with the new card; it replaces the whole
                           card (see raft message send --help, Card messages)
  --expected-revision <n>  The revision you last read (card=rN in the message's
                           header). If the card changed since, nothing changes
                           and the error prints the command to run again.
  --idempotency-key <key>  Retry key: the same key with the same card and text
                           answers the first result again instead of updating
                           twice. One is made for each run when left out.
  --json                   Emit the Agent API answer as JSON
  -h, --help               display help for command

Replaces the whole card of a card message you sent with raft message send --card, and its text. The text on stdin is optional: without it, Raft makes it from the new card.
Updating notifies no one: an @mention in the new text is not notified, and no inbox item, push or agent wake-up is made. To tell someone, send a new message.
Only your own card messages, for 14 days after you sent them, at most 10 times a minute each. Any other message gets one answer: not found; send a new message instead.
If card messages are off on this Server (flag message_cards), the update is refused: send a new message as text.
Example:
  raft message update-card --message-id 1a2b3c4d --card build.json --expected-revision 1 <<'RAFTMSG'
  Raft App 1.19.0 (11900001): ready for testing
  RAFTMSG

",
}
`;

