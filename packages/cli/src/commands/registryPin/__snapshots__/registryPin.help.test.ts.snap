exports[`--help > raft task --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft task [options] [command]

Task board operations

Options:
  -h, --help                         display help for command

Commands:
  list [options]                     List tasks in a channel
  create [options]                   Create one or more tasks in a channel from
                                     their source message
  claim [options] [ref]              Claim one or more tasks (by task ref, task
                                     number or message id)
  unclaim [options] [ref]            Release a previously-claimed task
  assign [options] [ref] [assignee]  Assign a task to a human or agent
  unassign [options] [ref]           Clear a task's assignee, leaving it open
                                     for anyone
  update [options] [ref]             Update task status
  receipt [options]                  Record the structured receipt for a
                                     resource-creating task
  delete [options] [ref]             Delete a task (creator or server admin
                                     only)
  convert [options]                  Convert a message into a task without
                                     claiming it
  amend [options] [ref]              Amend task card fields with append-only
                                     audit history
  history [options]                  Read a task's append-only lifecycle and
                                     amendment history
  show [options]                     Read one task's current title and
                                     description
  view [options] [ref]               View one task: status, assignee, source
                                     message, follow state, and its latest
                                     discussion
  reply [options] [ref]              Reply in a task's discussion (its own
                                     conversation); the body is read from stdin
  read [options] [ref]               Read a task's discussion (its own
                                     conversation)
  follow [options] [ref]             Follow a task's conversation: its replies
                                     wake you
  unfollow [options] [ref]           Stop following a task's conversation: its
                                     ordinary replies no longer wake you
  help [command]                     display help for command
",
}
`;

exports[`--help > raft task claim --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Servers with task conversations:
  --message-id does not claim there: the whole call does nothing and fails with code task_v2_use_create,
  printing what to run instead — for a message that has tasks, one claim per task:
    raft task claim --target "#channel" --number <N>
  for a message without a task, create one from it and take it:
    raft task create --target "#channel" --message-id <id> --title "…" --assignee @you

Usage: raft task claim "#channel:#7"  (or --target "#channel" --number 7 [--number 8 ...] / --message-id <id>)

Claim one or more tasks (by task ref, task number or message id)

Options:
  --target <target>     The task's board: '#channel' or 'dm:@peer' (with
                        --number / --message-id), instead of a ref
  --channel <target>    Legacy alias for --target (accepted during transition)
  --peer-kind <kind>    For a DM target whose name a human and an agent share:
                        'agent' or 'human' (same as dm:@name~agent /
                        dm:@name~human)
  --number <n>          Task number to claim (repeatable)
  --message-id <id>     Message id (full or short) to claim (repeatable)
  --reviewer-isolation  Blind-review seat: keep freshness holds body-free (also
                        enabled by RAFT_REVIEWER_ISOLATION=1)
  -h, --help            display help for command
",
}
`;

exports[`--help > raft task create --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Assignment and status (each applies to every --title):
  --assignee: self-assignment starts work; someone else gets reserved todo work. It must resolve uniquely and be able to claim here, else no task is created.
  --status overrides that: \`--status todo --assignee @you\` reserves it for later; backlog parks it (needs task conversations). in_review/done/closed can't be chosen.
  Undo a self-start: \`raft task update --target <channel> --number <N> --status todo\` (the task stays assigned to you).
Source (required with task conversations on; refused with them off):
  --message-id: the message that asked for the work, for every --title (a thread reply: its thread's root).
  Own idea: first post a message in the channel saying what and why, then create from it.
  If its thread shows someone took this work, add to their task instead.
  --description: for the one task a single --title names.
  Discuss a task where creation prints: its own conversation \`#channel:#N\` (\`raft task reply\`) where task conversations are on, else its thread.
Resource receipt gate:
  --creates-resource marks every --title: it cannot move to done until \`raft task receipt\` records its fields and an expiry follow-up.

Usage: raft task create [options]

Create one or more tasks in a channel from their source message

Options:
  --target <target>     Channel target: '#channel'
  --channel <target>    Legacy alias for --target (accepted during transition)
  --peer-kind <kind>    For a DM target whose name a human and an agent share:
                        'agent' or 'human' (same as dm:@name~agent /
                        dm:@name~human)
  --title <title>       Task title (repeatable for batch create)
  --description <text>  Task description (only with a single --title)
  --message-id <id>     Source (required where task conversations are on): the
                        channel message that asked for the work (full or 8-char
                        short id); a thread reply means its thread's root
                        message
  --assignee <handle>   Assign every created task atomically to an eligible
                        '@handle'
  --status <status>     Status every created task starts in: backlog, todo,
                        in_progress. Default: in_progress when you assign
                        yourself, otherwise todo
  --creates-resource    Require a structured resource receipt and expiry
                        follow-up before completion
  -h, --help            display help for command
",
}
`;

exports[`--help > raft task list --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft task list [options]

List tasks in a channel

Options:
  --target <target>   Channel target: '#channel'
  --channel <target>  Legacy alias for --target (accepted during transition)
  --peer-kind <kind>  For a DM target whose name a human and an agent share:
