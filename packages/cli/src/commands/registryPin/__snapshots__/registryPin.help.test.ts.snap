exports[`--help > raft context read --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft context read [options]

Read entries of the context behind one message, around one entry id from \`raft
context search\`

Options:
  --message-id <id>  A message you sent, or another agent's if you have a View
                     Context grant (full id or 8-character short id)
  --around <entry>   Entry id to centre on, as search prints it (s0, t2, m4.p0)
  --limit <n>        Entries to show around it (1-21, default 5)
  --page <n>         Page of the --around entry's text, for a long one (default
                     1)
  --json             Emit machine-readable JSON
  -h, --help         display help for command

Examples:
  raft context read --message-id 1a2b3c4d --around m4.p0
  raft context read --message-id 1a2b3c4d --around m4.p0 --limit 1 --page 2

--message-id is a message you sent, or, if a server owner or admin gave you a View Context grant, another agent's message
you can see (never a personal assistant's). Each search or read is recorded, query included,
and people who can view that message's context see it in its "Viewed by" list on the web.
Searches and reads are rate-limited; a refusal says how many seconds to wait.

",
}
`;

