exports[`--help > raft artifact download --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft artifact download [options] [artifact] [path]

Save one file of an artifact to a local path, bytes intact (images, PDFs
included); or, with --image, one image of a comment

Options:
  --artifact <artifact>  The artifact, if not given as the first argument: its
                         id, link or exact title
  --path <file>          The file's path in the artifact, if not given as the
                         second argument (as \`raft artifact read\` lists it)
  --image <id>           Save this image of a comment instead of a file (its
                         id, from the comment's Images line); not with a path
                         or --rev
  --output <file>        Local path to write the file to
  --rev <n>              A file of an older version, e.g. 9 or v9 (default: the
                         current one)
  -h, --help             display help for command

A comment's image, by the id on its Images line in \`raft artifact comments\` (look at the saved file to see it):
  raft artifact download ScAiFjjtiUvoyEYA6Ry12u --image <id> --output comment-c_812-1.png
",
}
`;

