exports[`--help > raft proc start --help 1`] = `
{
  "exitCode": 0,
  "requests": [],
  "stderr": "",
  "stdout": "Usage: raft proc start [--name <name>] [--cwd <dir>] -- <command> [args...]

Start a background job the Computer runs for this agent; returns at once

Options:
  --name <name>  Job name (letters, digits, - and _; at most 40). Default: the
                 command's name, made unique
  --cwd <dir>    Working directory, resolved against the current one. Default:
                 the current directory
  -h, --help     display help for command

Put the command after --. The job keeps running after this command returns,
across turns and while the agent sleeps; it stops when a person stops the agent,
or the agent is deleted or moved to another Computer.
Its stdout and stderr go to a log the Computer keeps (raft proc logs).
At most 8 jobs run at once per agent.

  raft proc start --name web -- npm run dev
  raft proc logs web
  raft proc stop web
",
}
`;

