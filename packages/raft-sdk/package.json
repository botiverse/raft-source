{
  "name": "@botiverse/raft-sdk",
  "version": "0.35.1",
  "license": "LicenseRef-Raft-License",
  "description": "Typed Raft Agent API client for external agents and bots.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/esm/app.js",
      "require": "./dist/cjs/app.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/esm/agent.js",
      "require": "./dist/cjs/agent.cjs"
    },
    "./continuations": {
      "types": "./dist/continuations.d.ts",
      "import": "./dist/esm/continuations.js",
      "require": "./dist/cjs/continuations.cjs"
    },
    "./operations.json": "./operations.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "operations.json",
    "CHANGELOG.md",
    "MIGRATING.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-source.git",
    "directory": "packages/raft-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:artifact": "pnpm run build && node --import @oxc-node/core/register scripts/check-packed-artifact.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run test:artifact",
    "lint:publish-package": "node --import @oxc-node/core/register scripts/check-publish-package.ts && node --import @oxc-node/core/register scripts/check-publish-workflow.ts",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "generate:operations": "node --import @oxc-node/core/register scripts/generate-operations.ts"
  },
  "devDependencies": {
    "@botiverse/raft-shared": "workspace:*",
    "@types/node": "^25.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
