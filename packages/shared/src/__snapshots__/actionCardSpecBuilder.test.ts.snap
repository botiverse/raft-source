  "icon": "package",
  "spec": {
    "elements": {
      "actions": {
        "children": [
          "installApp",
        ],
        "props": {
          "direction": "row",
          "role": "actions",
          "wrap": true,
        },
        "type": "Stack",
      },
      "agent": {
        "props": {
          "label": {
            "$msg": "actionCard.field.agent",
          },
          "value": [
            {
              "fallback": "scout",
              "id": "2d3a9e6a-3f4c-4b8d-9e5f-7a9b0c1d2e3f",
              "kind": "agent",
            },
          ],
        },
        "type": "Field",
      },
      "installApp": {
        "props": {
          "action": {
            "kind": "execute",
          },
          "emphasis": "primary",
          "label": {
            "$msg": "actionCard.verb.installApp",
          },
        },
        "type": "Button",
      },
      "ownerOnly": {
        "props": {
          "text": {
            "$msg": "actionCard.installMarketplaceOwnerOnly",
          },
          "tone": "info",
        },
        "type": "Notice",
      },
      "properties": {
        "children": [
          "service",
          "agent",
        ],
        "props": {
          "direction": "column",
          "wrap": false,
        },
        "type": "Stack",
      },
      "reason": {
        "children": [
          "reasonLabel",
          "reasonText",
        ],
        "props": {
          "direction": "column",
          "role": "reason",
          "wrap": false,
        },
        "type": "Stack",
      },
      "reasonLabel": {
        "props": {
          "mono": false,
          "text": {
            "$msg": "actionCard.reason",
          },
          "tone": "muted",
        },
        "type": "Text",
      },
      "reasonText": {
        "props": {
          "mono": false,
          "text": "scout requested Vault, which is public in the Raft Marketplace but is not installed on this Server.",
          "tone": "default",
        },
        "type": "Text",
      },
      "root": {
        "children": [
          "ownerOnly",
          "setupRequired",
          "setupDescription",
          "properties",
          "reason",
          "scopes",
          "actions",
        ],
        "props": {
          "direction": "column",
          "wrap": false,
        },
        "type": "Stack",
      },
      "scopes": {
        "props": {
          "agentName": "scout",
          "scopes": [
            "identity:read",
          ],
        },
        "type": "ScopeList",
      },
      "service": {
        "props": {
          "label": {
            "$msg": "actionCard.field.service",
          },
          "value": "Vault",
        },
        "type": "Field",
      },
      "setupDescription": {
        "props": {
          "mono": false,
          "text": "Pick the vault to share.",
          "tone": "default",
        },
        "type": "Text",
      },
      "setupRequired": {
        "props": {
          "text": {
            "$msg": "actionCard.appSetup.requiredAfterInstall",
          },
          "tone": "info",
        },
        "type": "Notice",
      },
    },
    "root": "root",
  },
  "title": {
    "$msg": "actionCard.title.installApp",
    "agent": {
      "fallback": "scout",
      "id": "2d3a9e6a-3f4c-4b8d-9e5f-7a9b0c1d2e3f",
      "kind": "agent",
    },
    "client": "Vault",
  },
}
`;

