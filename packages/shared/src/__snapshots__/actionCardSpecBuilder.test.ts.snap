      "q_window": {
        "props": {
          "label": {
            "$msg": "actionCard.question.question",
          },
          "value": "Which window?",
        },
        "type": "Field",
      },
      "reason": {
        "children": [
          "reasonLabel",
          "reasonText",
        ],
        "props": {
          "direction": "column",
          "role": "reason",
          "wrap": false,
        },
        "type": "Stack",
      },
      "reasonLabel": {
        "props": {
          "mono": false,
          "text": {
            "$msg": "actionCard.reason",
          },
          "tone": "muted",
        },
        "type": "Text",
      },
      "reasonText": {
        "props": {
          "mono": false,
          "text": "Before I deploy.",
          "tone": "default",
        },
        "type": "Text",
      },
      "root": {
        "children": [
          "properties",
          "reason",
          "actions",
        ],
        "props": {
          "direction": "column",
          "wrap": false,
        },
        "type": "Stack",
      },
    },
    "root": "root",
  },
  "title": {
    "$msg": "actionCard.question.title.one",
    "count": 1,
  },
}
`;

