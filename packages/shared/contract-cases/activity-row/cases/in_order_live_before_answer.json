{
  "formatVersion": 1,
  "id": "in_order_live_before_answer",
  "rule": "position",
  "title": "Live 100 and 101, then an answer at 101: correct, and nothing is re-read",
  "why": "The common case must cost nothing: applied seqs at or below the answer's position are trusted as counted in it when no inversion was seen.",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/shared/src/activityRowPosition.ts (reduceActivityRow; not wired yet, step 2)"
    ],
    "server": [
      "packages/server/src/services/channelService.ts (latestActivitySeqSameSource; the row's latestActivitySeq)",
      "infra/risingwave/sql/075-inbox-cursor-decouple.sql (unread_count and latest_seq from one materialized row)"
    ]
  },
  "given": {
    "row": {
      "unreadCount": 0,
      "hasMention": false,
      "position": "99",
      "mentionOnly": false
    }
  },
  "steps": [
    {
      "act": "liveMessage",
      "seq": "100",
      "counts": true,
      "mentionsViewer": false
    },
    {
      "act": "liveMessage",
      "seq": "101",
      "counts": true,
      "mentionsViewer": false
    },
    {
      "act": "answer",
      "row": {
        "unreadCount": 2,
        "hasMention": false,
        "position": "101",
        "mentionOnly": false
      }
    }
  ],
  "checkpoints": [
    {
      "afterStep": 2,
      "row": {
        "unreadCount": 2,
        "position": "101"
      },
      "reread": false
    }
  ],
  "expect": {
    "row": {
      "unreadCount": 2,
      "position": "101"
    },
    "reread": false
  }
}
