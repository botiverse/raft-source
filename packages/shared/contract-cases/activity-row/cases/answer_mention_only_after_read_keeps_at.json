{
  "formatVersion": 1,
  "id": "answer_mention_only_after_read_keeps_at",
  "rule": "position",
  "title": "A mention-only answer at or below the read seq is taken as it is: its @ stays",
  "why": "The read seq drops what an answer counted at or below it, but a mention-only row's @ does not follow the read cursor on every server path (a read on such a row re-reads it rather than clearing it, rule 7). So a mention-only answer is not cleared by the read seq (Scout, #15301 review).",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/shared/src/activityRowPosition.ts (reduceActivityRow, mergeAnswer: readSeq, mention-only)"
    ],
    "app": [
      "compose/shared/src/commonMain/kotlin/build/raft/app/data/ActivityRowPosition.kt (reduceActivityRow: readSeq)"
    ]
  },
  "given": { "row": { "unreadCount": 1, "hasMention": false, "position": "101", "mentionOnly": false } },
  "steps": [
    { "act": "read", "seq": "101" },
    { "act": "answer", "row": { "unreadCount": 0, "hasMention": true, "position": "101", "mentionOnly": true } }
  ],
  "checkpoints": [
    { "afterStep": 1, "row": { "unreadCount": 0, "hasMention": false, "position": "101" }, "reread": false }
  ],
  "expect": { "row": { "unreadCount": 0, "hasMention": true, "position": "101", "mentionOnly": true }, "reread": false }
}
