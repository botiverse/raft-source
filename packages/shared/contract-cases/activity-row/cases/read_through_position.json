{
  "formatVersion": 1,
  "id": "read_through_position",
  "rule": "position",
  "title": "A read at or past the row's position clears its unread and @",
  "why": "Everything the row counts is at or below its position.",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/shared/src/activityRowPosition.ts (reduceActivityRow; not wired yet, step 2)"
    ],
    "server": [
      "packages/server/src/services/channelService.ts (latestActivitySeqSameSource; the row's latestActivitySeq)",
      "infra/risingwave/sql/075-inbox-cursor-decouple.sql (unread_count and latest_seq from one materialized row)"
    ]
  },
  "given": {
    "row": {
      "unreadCount": 3,
      "hasMention": true,
      "position": "101",
      "mentionOnly": false
    }
  },
  "steps": [
    {
      "act": "read",
      "seq": "101"
    }
  ],
  "expect": {
    "row": {
      "unreadCount": 0,
      "hasMention": false,
      "position": "101"
    },
    "reread": false
  }
}
