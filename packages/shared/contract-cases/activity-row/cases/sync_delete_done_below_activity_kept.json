{
  "formatVersion": 1,
  "id": "sync_delete_done_below_activity_kept",
  "rule": "sync_inbox_row",
  "title": "A Done delete at a position below the row's activity keeps the row; at its position it removes it",
  "why": "A done delete carries the conversation's latest seq when it was marked Done. A message above it (live, or in a newer answer) brought the row back after the Done, so the delete does not apply; a delete at or past what the row shows does.",
  "status": "agreed",
  "sources": {
    "web": ["packages/shared/src/activityRowPosition.ts (applySyncInboxRowChange)"],
    "server": ["packages/server/src/services/syncInboxRows.ts (done delete: position = doneFrontierSeq)"]
  },
  "given": { "row": { "unreadCount": 0, "hasMention": false, "position": "104", "mentionOnly": false } },
  "steps": [
    { "act": "liveMessage", "seq": "105", "counts": true, "mentionsViewer": false },
    { "act": "syncDelete", "position": "104", "reason": "done" },
    { "act": "syncDelete", "position": "105", "reason": "done" }
  ],
  "checkpoints": [
    { "afterStep": 2, "row": { "unreadCount": 1, "position": "105" }, "removed": false, "reread": false }
  ],
  "expect": { "removed": true, "reread": false }
}
