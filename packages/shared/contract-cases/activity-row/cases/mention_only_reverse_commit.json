{
  "formatVersion": 1,
  "id": "mention_only_reverse_commit",
  "rule": "position",
  "title": "A mention at or below a mention-only row's position, not applied, re-reads the row",
  "why": "Same as any row: it may have committed after the mention that set the position.",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/shared/src/activityRowPosition.ts (reduceActivityRow; not wired yet, step 2)"
    ],
    "server": [
      "packages/server/src/services/channelService.ts (latestActivitySeqSameSource; the row's latestActivitySeq)",
      "infra/risingwave/sql/075-inbox-cursor-decouple.sql (unread_count and latest_seq from one materialized row)"
    ]
  },
  "given": {
    "row": {
      "unreadCount": 0,
      "hasMention": true,
      "position": "101",
      "mentionOnly": true
    }
  },
  "steps": [
    {
      "act": "liveMessage",
      "seq": "100",
      "counts": false,
      "mentionsViewer": true
    }
  ],
  "expect": {
    "row": {
      "unreadCount": 0,
      "hasMention": true,
      "position": "101",
      "mentionOnly": true
    },
    "reread": true
  }
}
