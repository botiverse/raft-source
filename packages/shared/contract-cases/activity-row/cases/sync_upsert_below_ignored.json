{
  "formatVersion": 1,
  "id": "sync_upsert_below_ignored",
  "rule": "sync_inbox_row",
  "title": "An inbox_row upsert below the held row's position is ignored",
  "why": "A row rebuilt by an earlier pull (or a lagging read model) can arrive after a newer answer of the same row. It is an older answer: the row keeps what it holds, as for any answer.",
  "status": "agreed",
  "sources": {
    "web": ["packages/shared/src/activityRowPosition.ts (applySyncInboxRowChange, mergeAnswer)"]
  },
  "given": { "row": { "unreadCount": 2, "hasMention": true, "position": "101", "mentionOnly": false } },
  "steps": [
    { "act": "answer", "row": { "unreadCount": 1, "hasMention": false, "position": "100", "mentionOnly": false, "readSeq": "99" } }
  ],
  "expect": { "row": { "unreadCount": 2, "hasMention": true, "position": "101", "mentionOnly": false }, "reread": false }
}
