{
  "formatVersion": 1,
  "id": "older_answer_kept",
  "rule": "position",
  "title": "An answer older than the row's delivered position is ignored",
  "why": "An older answer can never overwrite a newer row.",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/shared/src/activityRowPosition.ts (reduceActivityRow; not wired yet, step 2)"
    ],
    "server": [
      "packages/server/src/services/channelService.ts (latestActivitySeqSameSource; the row's latestActivitySeq)",
      "infra/risingwave/sql/075-inbox-cursor-decouple.sql (unread_count and latest_seq from one materialized row)"
    ]
  },
  "given": {
    "row": {
      "unreadCount": 1,
      "hasMention": false,
      "position": "99",
      "mentionOnly": false
    }
  },
  "steps": [
    {
      "act": "liveMessage",
      "seq": "100",
      "counts": true,
      "mentionsViewer": false
    },
    {
      "act": "answer",
      "row": {
        "unreadCount": 0,
        "hasMention": false,
        "position": "98",
        "mentionOnly": false
      }
    }
  ],
  "expect": {
    "row": {
      "unreadCount": 2,
      "position": "100"
    },
    "reread": false
  }
}
