{
  "name": "@botiverse/raft-shared",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi-fresh": "pnpm generate:openapi && git diff --exit-code openapi/openapi.json src/generated/openapi.ts",
    "check:openapi-deterministic": "tsx scripts/check-openapi-determinism.ts",
    "lint:openapi": "redocly lint openapi/openapi.json --extends=minimal --format=stylish",
    "check:openapi-consumer": "tsc --noEmit --project tsconfig.openapi.json",
    "test:attachment-upload-contract": "node --import tsx --test src/attachmentUploadContract.test.ts",
    "check:openapi": "pnpm check:openapi-fresh && pnpm check:openapi-deterministic && pnpm lint:openapi && pnpm check:openapi-consumer && pnpm test:attachment-upload-contract",
    "generate:runtime-provider-display-names": "tsx scripts/generate-runtime-provider-display-names.ts",
    "check:runtime-provider-display-names-fresh": "pnpm generate:runtime-provider-display-names && git diff --exit-code src/generated/runtimeProviderDisplayNames.ts",
    "generate:agent-api-routes": "tsx scripts/generate-agent-api-routes.ts",
    "check:agent-api-routes-fresh": "pnpm generate:agent-api-routes && git diff --exit-code src/generated/agentApiRoutes.ts",
    "typecheck": "tsc --noEmit",
    "test:message-lockstep": "node scripts/check-agent-api-message-lockstep.mjs",
    "test": "pnpm run test:message-lockstep && node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@botiverse/raft-sync-core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@redocly/cli": "2.40.0",
    "@types/node": "^25.5.0",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod-openapi": "6.0.0"
  }
}
