  "scripts": {
    "generate:openapi": "node --import @oxc-node/core/register scripts/generate-openapi.ts",
    "check:openapi-fresh": "pnpm generate:openapi && git diff --exit-code openapi/openapi.json src/generated/openapi.ts",
    "check:openapi-deterministic": "node --import @oxc-node/core/register scripts/check-openapi-determinism.ts",
    "lint:openapi": "redocly lint openapi/openapi.json --extends=minimal --format=stylish",
    "check:openapi-consumer": "tsrs --noEmit --project tsconfig.openapi.json",
    "test:attachment-upload-contract": "vitest run src/attachmentUploadContract.test.ts",
    "test:read-state-contract": "vitest run src/readStateContract.test.ts",
    "check:openapi": "pnpm check:openapi-fresh && pnpm check:openapi-deterministic && pnpm lint:openapi && pnpm check:openapi-consumer && pnpm test:attachment-upload-contract && pnpm test:read-state-contract",
    "generate:runtime-provider-display-names": "node --import @oxc-node/core/register scripts/generate-runtime-provider-display-names.ts",
    "check:runtime-provider-display-names-fresh": "pnpm generate:runtime-provider-display-names && git diff --exit-code src/generated/runtimeProviderDisplayNames.ts",
    "generate:agent-api-routes": "node --import @oxc-node/core/register scripts/generate-agent-api-routes.ts",
    "check:agent-api-routes-fresh": "pnpm generate:agent-api-routes && git diff --exit-code src/generated/agentApiRoutes.ts",
    "generate:agent-api-description": "node --import @oxc-node/core/register scripts/generate-agent-api-description.ts",
    "check:agent-api-description-fresh": "pnpm generate:agent-api-description && git diff --exit-code agent-api/agent-api.v1.json",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test:message-lockstep": "node --import @oxc-node/core/register scripts/check-agent-api-message-lockstep.ts",
    "test": "pnpm run test:message-lockstep && vitest run"
  },
