{
  "protocolVersion": 3,
  "runtimeId": "codex",
  "schemaVersion": "codex.create.v1",
  "dataSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model"
    ],
    "properties": {
      "model": {
        "type": "string",
        "title": "Model",
        "minLength": 1,
        "x-optionSource": "model"
      },
      "reasoningEffort": {
        "type": "string",
        "title": "Reasoning",
        "x-optionSource": "reasoningEffort"
      },
      "fastMode": {
        "type": "boolean",
        "title": "Fast mode"
      },
      "speed": {
        "type": "string",
        "title": "Speed",
        "x-optionSource": "speed"
      },
      "envVars": {
        "type": "object",
        "title": "Environment Variables",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "uiSchema": {
    "order": [
      "model",
      "reasoningEffort",
      "fastMode",
      "speed",
      "envVars"
    ],
    "layout": {
      "advanced": [
        "/envVars"
      ]
    },
    "localization": {
      "model": {
        "label": "Model",
        "hint": "Models available from this computer's Codex CLI. You can also type a model ID."
      },
      "reasoningEffort": {
        "label": "Reasoning",
        "hint": "Available values depend on the selected model.",
        "choices": {
          "off": {
            "label": "No reasoning",
            "description": "Answers directly, without a thinking phase"
          },
          "minimal": {
            "label": "Minimal",
            "description": "Very light reasoning for the fastest responses"
          },
          "low": {
            "label": "Low",
            "description": "Fast responses with lighter reasoning"
          },
          "medium": {
            "label": "Medium",
            "description": "Balances speed and reasoning depth for everyday tasks"
          },
          "high": {
            "label": "High",
            "description": "Greater reasoning depth for complex problems"
          },
          "xhigh": {
            "label": "Extra high",
            "description": "Extra high reasoning depth for complex problems"
          },
          "max": {
            "label": "Max",
            "description": "Maximum reasoning depth for the hardest problems"
          },
          "ultra": {
            "label": "Ultra",
            "description": "Maximum reasoning with automatic task delegation"
          }
        }
      },
      "fastMode": {
        "label": "Fast mode",
        "hint": "Launch this runtime with higher speed at a higher cost per token."
      },
      "speed": {
        "label": "Speed",
        "hint": "Speeds this model offers on this computer's Codex account. Faster speeds use more of your plan."
      },
      "envVars": {
        "label": "Environment Variables",
        "hint": "These will be injected into the runtime command environment."
      }
    },
    "rules": [
      {
        "scope": "#/properties/fastMode",
        "effect": "HIDE",
        "condition": {
          "scope": "#/properties/model",
          "schema": {
            "enum": [
              "gpt-6.2-astra",
              "gpt-5-mini"
            ]
          }
        }
      },
      {
        "scope": "#/properties/speed",
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/model",
          "schema": {
            "enum": [
              "gpt-6.2-astra"
            ]
          }
        }
      }
    ]
  },
  "capabilities": {
    "providerKinds": [],
    "writeOnlyPointers": [],
    "forbiddenPointers": [
      "/hostUserState"
    ]
  },
  "optionSources": {
    "model": {
      "protocolVersion": 1,
      "runtimeId": "codex",
      "schemaVersion": "codex.create.v1",
      "sourceId": "model",
      "kind": "select",
      "pointer": "/model"
    },
    "speed": {
      "protocolVersion": 1,
      "runtimeId": "codex",
      "schemaVersion": "codex.create.v1",
      "sourceId": "speed",
      "kind": "dependent_select",
      "pointer": "/speed",
      "dependsOn": "/model"
    },
    "reasoningEffort": {
      "protocolVersion": 1,
      "runtimeId": "codex",
      "schemaVersion": "codex.create.v1",
      "sourceId": "reasoningEffort",
      "kind": "dependent_select",
      "pointer": "/reasoningEffort",
      "dependsOn": "/model"
    }
  },
  "values": {
    "model": "my-org/codex-custom",
    "reasoningEffort": "high",
    "fastMode": true,
    "speed": "priority",
    "envVars": {
      "EXAMPLE_FLAG": "1"
    }
  },
