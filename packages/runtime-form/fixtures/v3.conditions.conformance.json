{
  "$comment": "Runtime form v3 condition conformance table (contract `Condition`). Every client evaluator must give `expected` for each case (condition.schema evaluated at condition.scope over `data`; absent value = \"\"), and must report every `unsupported` schema as unsupported (the form is then unavailable). const/enum compare structurally (object key order does not count); pattern is the portable subset in the package README (ECMAScript semantics: `$` only at the very end, `.` excludes only \\n, \\r, U+2028, U+2029). Consumed by packages/runtime-form/src/v3Rules.test.ts and the mobile tests.",
  "cases": [
    {
      "name": "const matches",
      "condition": {
        "scope": "#/properties/providerId",
        "schema": {
          "const": "deepseek"
        }
      },
      "data": {
        "providerId": "deepseek"
      },
      "expected": true
    },
    {
      "name": "const differs",
      "condition": {
        "scope": "#/properties/providerId",
        "schema": {
          "const": "deepseek"
        }
      },
      "data": {
        "providerId": "openai"
      },
      "expected": false
    },
    {
      "name": "const on absent value compares with empty string",
      "condition": {
        "scope": "#/properties/providerId",
        "schema": {
          "const": ""
        }
      },
      "data": {},
      "expected": true
    },
    {
      "name": "const boolean",
      "condition": {
        "scope": "#/properties/flag",
        "schema": {
          "const": true
        }
      },
      "data": {
        "flag": true
      },
      "expected": true
    },
    {
      "name": "const boolean differs from string",
