        },
        "pointer": {
          "type": "string"
        },
        "dependsOn": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "OptionSource": {
      "type": "object",
      "description": "Response of the option-sources endpoint. select: options + defaultValue. dependent_select: per-value lists keyed by the value of dependsOn. `customValueAllowed`, `status`, `reason` and `retryable` are sent only on the v2 endpoint and only to forms that list the matching capability (`select.custom_value`, `option_source.status`); a form without the capability gets the source exactly as before. Form-consistency parameter `?formRevision=<token>` (Definition.revision), optional, three outcomes: (1) absent — the source answers with the plain direct-option protocol and NEVER includes saved-connection options (Option.connectionId) or connection-keyed model maps, so pre-existing clients keep working unchanged; (2) present and matching the server's current build — the source answers within the capability range the form declared; (3) present and not matching — HTTP 409 with code `form_revision_stale` and recovery `refetch_form`; the client must refetch the whole form and must never merge new options into a stale form. The revision guards form consistency only; authorization and connection state are re-checked on every source request and again on save.",
      "required": [
        "sourceId",
        "kind",
        "pointer"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "select",
            "dependent_select"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "dependsOn": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "defaultValue": {
          "type": "string"
        },
        "optionsByValue": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
