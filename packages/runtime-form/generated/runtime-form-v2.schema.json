    "Condition": {
      "type": "object",
      "description": "v3: `schema` is evaluated against the value at `scope` (`#` = the whole values object, `#/properties/<key>` = one field). Supported keywords: const, enum (structural equality: object key order does not count), pattern (a portable ECMAScript subset, unanchored unless the pattern anchors; see the package README), not, anyOf, allOf, properties. An absent value is evaluated as \"\". A schema using any other keyword, or a pattern outside the subset, is unsupported: the client treats the whole form as unavailable (new keywords need a required client capability). packages/runtime-form/fixtures/v3.conditions.conformance.json is the conformance table every client runs.",
      "required": [
        "scope",
        "schema"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "schema": {}
      },
      "additionalProperties": true
    },
