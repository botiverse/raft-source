          }
        }
      },
      "additionalProperties": true
    },
    "FieldSchema": {
      "type": "object",
      "description": "Render by `type` (with x-optionSource or x-optionsFrom), never by field name. An unknown `type` is unsupported: skip it if optional, block saving if required.",
