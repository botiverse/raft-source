          }
        },
        "customValueAllowed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "fallback",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "probe_timeout",
            "probe_failed",
            "missing_config",
            "no_models",
            "unsupported",
            "machine_offline"
