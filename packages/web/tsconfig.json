{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "../..",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "visual-testing/**/*.ts", "visual-testing/**/*.tsx"],
  "//exclude": "Feature tests (src/features/<feature>/tests/) are test code, as tests/ is: not part of the app typecheck (scripts/testLocations.ts).",
  "exclude": ["src/features/*/tests/**"]
}
