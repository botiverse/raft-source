{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import @oxc-node/core/register scripts/run-vitest-tests.ts 'tests/**/*.test.ts' 'src/features/*/tests/**/*.test.ts'"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "reporters": ["clear-text", "html"],
  "timeoutMS": 60000
}
