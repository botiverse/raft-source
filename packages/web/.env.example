# @botiverse/raft-web — React + Vite frontend
# Copy to .env for local development. Vercel: set in project dashboard.
#
# NOTE: Vite env vars must start with VITE_ to be exposed to client code.

# Backend API URL (includes protocol, no trailing slash)
# Local dev: not needed — Vite proxy forwards /api and /socket.io to localhost:3001
# Vercel production: https://api.slock.ai
# Vercel preview:    https://api-staging.slock.ai
# VITE_API_URL=

# Branch preview identity. Hosted previews set these in CI; local runs usually
# leave them unset. API target values are staging or prod.
# VITE_DEPLOYMENT_ENV=web-preview
# VITE_PREVIEW_BRANCH=feature/example
# VITE_PREVIEW_API_TARGET=staging
# VITE_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567

# Optional standalone feedback-export worker integration.
# When set, the web app shows "Report Issue" in the agent profile and uses the
# slock server + external slock-feedback worker flow:
# scope attestation -> worker create -> direct upload -> worker complete.
# VITE_FEEDBACK_EXPORT_URL=

# Optional L4 web auth tracing receiver (trace-upload worker origin).
# When set, the web app emits bounded, fire-and-forget auth/session traces
# (slock.auth.*) via scope attestation (web-trace-batch:create) -> POST /api/web-traces.
# DEDICATED var: do NOT reuse VITE_FEEDBACK_EXPORT_URL. Point at the prod-correct
# AWS ECS receiver, e.g. https://slock-trace-upload.botiverse.dev. Unset => producer no-op.
# See docs/contracts/auth-session-contract.md (Observability Contract).
# VITE_WEB_TRACE_URL=

# Optional local-only React Scan initial state.
# The React Scan toolbar/switch is available in dev. Keep unset for shared dev
# preview, screenshots, and screen recordings so scanning starts off; set true
# only when you want your local dev session to start with scanning enabled.
# VITE_ENABLE_REACT_SCAN=true
