{
  "name": "@botiverse/raft-daemon",
  "version": "1.25.0",
  "private": true,
  "license": "LicenseRef-Raft-License",
  "type": "module",
  "bin": {
    "raft-daemon": "dist/raft-daemon.js",
    "slock-daemon": "dist/slock-daemon.js"
  },
  "exports": {
    "./core": {
      "types": "./src/core.ts",
      "import": "./dist/core.js"
    },
    "./bundled-cli": {
      "types": "./src/bundledRaftCli.ts",
      "import": "./dist/bundledRaftCli.js"
    },
    "./context-view-restore-child": {
      "types": "./src/agentContextView/contextViewRestoreChild.ts",
      "import": "./dist/agentContextView/contextViewRestoreChild.js"
    },
    "./runtime-detection-child": {
      "types": "./src/runtimeDetectionChild.ts",
      "import": "./dist/runtimeDetectionChild.js"
    },
    "./dist/raft-daemon.js": "./dist/raft-daemon.js",
    "./dist/slock-daemon.js": "./dist/slock-daemon.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-source.git",
    "directory": "packages/daemon"
  },
  "scripts": {
    "dev": "pnpm --filter @botiverse/raft build && node --watch-path=src --watch-path=../shared/src --watch-path=../shared/assets --watch-path=../shared/announcement-audience.ts --watch-path=../shared/announcement-presentation.ts --watch-path=../shared/feature-flag-taxonomy.ts --watch-path=../sync-core/src --watch-path=../sync-core/contracts --watch-path=../trace-client/src --import @oxc-node/core/register src/index.ts",
    "start": "node --import @oxc-node/core/register src/index.ts",
    "build": "pnpm --filter @botiverse/raft build && tsdown && node -e \"require('fs').cpSync('../cli/dist','dist/cli',{recursive:true})\" && node scripts/write-dist-bins.mjs",
    "test": "node --import @oxc-node/core/register ../../scripts/vitest/run-in-slot.ts vitest run",
    "test:sea-host": "vitest run --config vitest.sea-host.config.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "generate:raft-cli-guide": "node --import @oxc-node/core/register scripts/generate-raft-cli-guide.ts",
    "check:raft-cli-guide-fresh": "pnpm generate:raft-cli-guide && git diff --exit-code ../../manual/agent-knowledge/raft-cli-overview.md",
    "generate:pi-builtin-models": "node --import @oxc-node/core/register scripts/generate-pi-builtin-models.ts",
    "check:pi-builtin-models-fresh": "pnpm generate:pi-builtin-models && git diff --exit-code ../shared/src/piBuiltinModels.generated.ts",
    "release:sdk-preflight": "node scripts/release-runtime-sdk-preflight.mjs"
  },
  "dependencies": {
    "@botiverse/kimi-code-sdk": "2.3.1-botiverse.1",
    "@botiverse/oar": "0.103.0",
    "@cursor/sdk": "1.3.1",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@jackwener/opencli": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^7.0.6",
    "proper-lockfile": "^4.1.2",
    "safe-regex2": "5.1.1",
    "tar-stream": "2.2.0",
    "typebox": "1.1.38",
    "undici": "8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@botiverse/raft": "workspace:*",
    "@botiverse/raft-shared": "workspace:*",
    "@botiverse/raft-trace-client": "workspace:*",
    "@oxc-node/core": "^0.1.6",
    "@types/node": "^25.5.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "^8.18.1",
    "diff": "8.0.4",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
