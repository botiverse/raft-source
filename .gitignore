node_modules/
# A symlinked node_modules (worktree setups) is a file, which "node_modules/" does not match.
node_modules
.amp/portals/*
dist/
h5-bundle/
dist-electron/
shim-dist/
*.log
.claude/*
!.claude/skills/
*.db
release/
!/scripts/release/
.env
.env.scopedb
.dev-env-*.json
.slockdev/
# Local uploads when the server or tests run from the repository root.
/uploads/
**/.wrangler/
**/.flow/
artifacts/perf/
packages/web/.playwright/
packages/cli/test-results/
packages/web/test-results/
# Playwright HTML report and e2e transport evidence (CI uploads it as an artifact).
packages/web/playwright-report/
packages/visual-testing/test-results/
# Local `slock-visual` / visual-testing playwright runs write these at the repo root.
artifacts/visual-testing/
visual-testing-results/
packages/server/.playwright/
packages/web/tests/stress/artifacts/
packages/web/.render-perf/

scripts/app-name-ratchet-baseline.txt.mutating


# Written by scripts/source-available/export-snapshot.ts into exported snapshots only;
# tests skip private-layout contracts when it exists.
/RELEASE_SOURCE

# vitest coverage reports (e.g. packages/sync-core test:coverage)
coverage/
# The official raft-computer-installer binaries (+ its LICENSE/NOTICE) Raft
# Desktop ships, fetched and sha256-verified at build time by
# apps/desktop/scripts/fetch-computer-installer.mjs from the pin in
# apps/desktop/build/computer-installer.json (which is committed).
apps/desktop/build/computer-installer/
