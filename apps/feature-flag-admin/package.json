  "devDependencies": {
    "@cloudflare/workers-types": "4.20260601.1",
    "@types/pg": "^8.20.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
